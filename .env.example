# --- LLM providers (order and per-agent models: backend/config/odin.yaml) ---
# Primary today: the "openai" provider pointed at Amazon Bedrock Mantle (OpenAI-compatible).
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_PROJECT_ID=default
OPENAI_API_KEY=
OPENAI_MODEL=minimax.minimax-m2.5
# Fallback: Bedrock in a second region, then Anthropic, then Groq. Empty keys are skipped.
BEDROCK_OPENAI_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/v1
BEDROCK_API_KEY=
BEDROCK_MODEL=minimax.minimax-m2.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Force every agent onto one provider (e.g. "fake" for an offline demo). Empty = use backend/config/odin.yaml
ODIN_FORCE_PROVIDER=

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragnarok-odin
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://odin:odin@localhost:5432/odin

# --- Web / auth ---
SECRET_KEY=change-me
# Fernet key for encrypting Google refresh tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Both must be the origin the browser uses. Team UI (Next.js dev server): http://127.0.0.1:3000
# Register <PUBLIC_BASE_URL>/auth/google/callback as the Google OAuth redirect URI.
PUBLIC_BASE_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000
# Allows POST /auth/dev-login (no Google). Turn off for anything public.
DEV_LOGIN=true

# --- Outbound ---
WEBHOOK_URL=
