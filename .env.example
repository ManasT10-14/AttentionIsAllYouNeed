# --- LLM providers (Bedrock primary -> OpenAI -> Anthropic -> Groq) ---
BEDROCK_OPENAI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
BEDROCK_API_KEY=
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Force every agent onto one provider (e.g. "fake" for an offline demo). Empty = use config/odin.yaml
ODIN_FORCE_PROVIDER=

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragnarok-odin
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Database ---
DATABASE_URL=postgresql+psycopg://odin:odin@localhost:5432/odin

# --- Web / auth ---
SECRET_KEY=change-me
# Fernet key for encrypting Google refresh tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Allows POST /auth/dev-login (no Google). Turn off for anything public.
DEV_LOGIN=true

# --- Outbound ---
WEBHOOK_URL=
