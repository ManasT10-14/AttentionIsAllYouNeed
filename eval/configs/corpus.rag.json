{
  "adapter": "corpus",
  "dataset": "../datasets/corpus/rag.json",
  "report": "../reports/corpus-rag.json",
  "concurrency": 2,
  "case_timeout_s": 300,
  "corpus": {"mode": "rag", "product_tracing": true},
  "judge": {"enabled": true, "model": "odin:openai", "timeout_s": 180},
  "tracing": {"enabled": true, "publish_timeout_s": 20},
  "include_tags": ["checkpoint-baseline"]
}
